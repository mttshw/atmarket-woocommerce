{
  "name": "atmarket/atproto-for-woocommerce",
  "description": "Publish your WooCommerce catalogue to your own AT Protocol account.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5"
  },
  "autoload-dev": {
    "psr-4": {
      "AtprotoWC\\": "src/",
      "AtprotoWC\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "platform": {
      "php": "8.3"
    }
  }
}
